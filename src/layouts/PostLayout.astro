---
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../lib/content";
import { withBase } from "../lib/urls";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface NeighborPost {
	title: string;
	href: string;
}

interface RelatedPost extends NeighborPost {
	description: string;
	pubDate: Date;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	category?: string;
	tags: string[];
	cover?: string;
	coverAlt?: string;
	readingTime: string;
	headings: Heading[];
	previousPost?: NeighborPost;
	nextPost?: NeighborPost;
	relatedPosts: RelatedPost[];
	canonicalUrl?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	category,
	tags,
	cover,
	coverAlt,
	readingTime,
	headings,
	previousPost,
	nextPost,
	relatedPosts,
	canonicalUrl,
} = Astro.props;
---

<BaseLayout
	title={`${title} — DARK TZY`}
	description={description}
	canonicalUrl={canonicalUrl}
	ogType="article"
	ogImage={cover}
	ogImageAlt={cover ? coverAlt ?? description : undefined}
	publishedTime={pubDate}
	updatedTime={updatedDate}
>
	<progress class="reading-progress" data-reading-progress max="100" value="0" aria-label="Article reading progress">0%</progress>
	<article class="article-shell">
		<header class="article-header" data-reveal>
			<a class="article-back-link" href={withBase("/posts/")}>← All journal entries</a>
			<p class="eyebrow article-kicker">{category ?? "JOURNAL"} / {formatDate(pubDate)}</p>
			<h1>{title}</h1>
			<p class="article-description">{description}</p>
			<div class="article-meta">
				<span>{readingTime}</span>
				{updatedDate && updatedDate.getTime() !== pubDate.getTime() && (
					<span>Updated {formatDate(updatedDate)}</span>
				)}
			</div>
			{tags.length > 0 && (
				<ul class="article-tags" aria-label="Tags">
					{tags.map((tag) => <li><a href={`${withBase("/posts/")}?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>)}
				</ul>
			)}
		</header>

		{cover && (
			<figure class="article-cover" data-reveal>
				<img
					src={withBase(cover)}
					alt={coverAlt ?? title}
					width="1200"
					height="675"
					loading="eager"
					fetchpriority="high"
				/>
			</figure>
		)}

		<div class="article-layout">
			<aside class="article-toc" aria-label="On this page" data-reveal>
				<p class="article-toc-title">ON THIS PAGE</p>
				{headings.length > 0 ? (
					<nav>
						<ul>
							{headings.filter((heading) => heading.depth <= 3).map((heading) => (
								<li class:list={{ "toc-nested": heading.depth === 3 }}>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ul>
					</nav>
				) : (
					<p class="article-toc-empty">No headings in this story.</p>
				)}
			</aside>

			<div class="article-prose">
				<slot />
			</div>
		</div>

		<nav class="article-pagination" aria-label="Journal navigation">
			{previousPost ? (
				<a class="article-pagination-link" href={withBase(previousPost.href)}>
					<span>← OLDER STORY</span>
					<strong>{previousPost.title}</strong>
				</a>
			) : <span />}
			{nextPost && (
				<a class="article-pagination-link article-pagination-next" href={withBase(nextPost.href)}>
					<span>NEWER STORY →</span>
					<strong>{nextPost.title}</strong>
				</a>
			)}
		</nav>

		{relatedPosts.length > 0 && (
			<aside class="related-stories" aria-labelledby="related-stories-title">
				<p class="eyebrow">CONTINUE READING</p>
				<h2 id="related-stories-title">In the same <em>conversation.</em></h2>
				<div class="related-stories-grid">
					{relatedPosts.map((relatedPost, index) => (
						<a class="related-story" href={withBase(relatedPost.href)}>
							<span>0{index + 1} / {formatDate(relatedPost.pubDate)}</span>
							<strong>{relatedPost.title}</strong>
							<p>{relatedPost.description}</p>
							<span class="related-story-arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</aside>
		)}
	</article>
	<script>
		const article = document.querySelector<HTMLElement>(".article-shell");
		const progress = document.querySelector<HTMLProgressElement>("[data-reading-progress]");
		if (article && progress) {
			let frame = 0;
			const updateProgress = () => {
				if (frame) return;
				frame = requestAnimationFrame(() => {
					const scrollableHeight = Math.max(
						1,
						article.offsetTop + article.offsetHeight - window.innerHeight,
					);
					progress.value = Math.min(100, Math.max(0, (window.scrollY / scrollableHeight) * 100));
					frame = 0;
				});
			};

			window.addEventListener("scroll", updateProgress, { passive: true });
			window.addEventListener("resize", updateProgress, { passive: true });
			updateProgress();
		}
	</script>
</BaseLayout>
