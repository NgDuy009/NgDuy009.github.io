---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { calculateReadingTime } from "../../lib/content";
import { absoluteSiteUrl } from "../../lib/urls";

export async function getStaticPaths() {
	const publishedPosts = (await getCollection("posts", ({ data }) => !data.draft))
		.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

	return publishedPosts.map((post, index) => {
		const previousPost = publishedPosts[index + 1];
		const nextPost = publishedPosts[index - 1];
		const relatedPosts = publishedPosts
			.filter((candidate) => candidate.id !== post.id)
			.map((candidate) => ({
				candidate,
				score:
					Number(Boolean(post.data.category && post.data.category === candidate.data.category)) +
					post.data.tags.filter((tag) => candidate.data.tags.includes(tag)).length,
			}))
			.filter(({ score }) => score > 0)
			.sort((a, b) => b.score - a.score || b.candidate.data.pubDate.getTime() - a.candidate.data.pubDate.getTime())
			.slice(0, 2)
			.map(({ candidate }) => ({
				title: candidate.data.title,
				href: `/posts/${candidate.id}/`,
				description: candidate.data.description,
				pubDate: candidate.data.pubDate,
			}));

		return {
			params: { slug: post.id },
			props: {
				post,
				previousPost: previousPost
					? { title: previousPost.data.title, href: `/posts/${previousPost.id}/` }
					: undefined,
				nextPost: nextPost
					? { title: nextPost.data.title, href: `/posts/${nextPost.id}/` }
					: undefined,
				relatedPosts,
			},
		};
	});
}

const { post, previousPost, nextPost, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
const canonicalUrl = Astro.site
	? absoluteSiteUrl(`/posts/${post.id}/`, Astro.site)
	: undefined;
---

<PostLayout
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	category={post.data.category}
	tags={post.data.tags}
	cover={post.data.cover}
	coverAlt={post.data.coverAlt}
	readingTime={calculateReadingTime(post.body ?? "")}
	headings={headings}
	previousPost={previousPost}
	nextPost={nextPost}
	relatedPosts={relatedPosts}
	canonicalUrl={canonicalUrl}
>
	<Content />
</PostLayout>
