---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { calculateReadingTime } from "../../lib/content";
import { withBase } from "../../lib/urls";
import { editorialImages } from "../../lib/editorial";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== featuredPost?.id);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
	a.localeCompare(b),
);
const searchIndex = posts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description: post.data.description,
	content: post.body ?? "",
	tags: post.data.tags,
	category: post.data.category ?? "",
}));
const searchIndexJson = JSON.stringify(searchIndex)
	.replaceAll("<", "\\u003c")
	.replaceAll("\u2028", "\\u2028")
	.replaceAll("\u2029", "\\u2029");
---

<BaseLayout
	title="Journal — DARK TZY"
	description="Fashion, visual culture, and personal notes from the DARK TZY journal."
>
	<section class="page-shell journal-page">
		<header class="journal-masthead" data-reveal>
			<div class="journal-heading-copy">
				<p class="eyebrow">JOURNAL / IDEAS IN MOTION</p>
				<h1>Notes on<br /><em>getting dressed.</em></h1>
				<p class="page-heading-description">
					Stories on fashion, personal style, and the visual culture around us.
				</p>
				<p class="journal-image-credit">FASHION & VISUAL CULTURE / AN OPEN JOURNAL</p>
			</div>
			<figure class="journal-masthead-image">
				<img src={withBase(editorialImages[3].src)} alt={editorialImages[3].alt} data-image-mask width="960" height="1200" fetchpriority="high" decoding="async" />
				<figcaption>Editorial reference / Unsplash · Not a portrait of the site owner.</figcaption>
			</figure>
		</header>
		<div class="collection-bar">
			<span>{featuredPost ? "Featured story & archive" : "All stories"}</span>
			<span>Journal / <strong data-post-count>{posts.length}</strong></span>
		</div>

		{featuredPost && (
			<article class="featured-journal-story" data-post-card={featuredPost.id} data-reveal>
				{featuredPost.data.cover && (
					<a class="featured-journal-image" href={withBase(`/posts/${featuredPost.id}/`)} aria-label={`Read ${featuredPost.data.title}`}>
						<img
							src={withBase(featuredPost.data.cover)}
							alt={featuredPost.data.coverAlt ?? featuredPost.data.title}
							width="1200"
							height="900"
							fetchpriority="high"
							decoding="async"
						/>
					</a>
				)}
				<div class="featured-journal-copy">
					<p class="eyebrow">FEATURED STORY / {featuredPost.data.category ?? "JOURNAL"}</p>
					<h2><a href={withBase(`/posts/${featuredPost.id}/`)}>{featuredPost.data.title}</a></h2>
					<p>{featuredPost.data.description}</p>
					<div class="featured-journal-meta">
						<time datetime={featuredPost.data.pubDate.toISOString()}>
							{new Intl.DateTimeFormat("en", { day: "numeric", month: "long", year: "numeric" }).format(featuredPost.data.pubDate)}
						</time>
						<span>{calculateReadingTime(featuredPost.body ?? "")}</span>
					</div>
					<a class="text-link" href={withBase(`/posts/${featuredPost.id}/`)}>Read the story <span aria-hidden="true">↗</span></a>
				</div>
			</article>
		)}

		<div class="post-search" data-reveal>
			<label class="post-search-label" for="post-search-input">SEARCH THE ARCHIVE</label>
			<input
				id="post-search-input"
				class="post-search-input"
				type="search"
				placeholder="Search title, story, or tag..."
				autocomplete="off"
			/>
			{tags.length > 0 && (
				<div class="tag-filters" aria-label="Filter stories by tag">
					<button class="tag-filter is-active" type="button" data-tag-filter="all" aria-pressed="true">
						All
					</button>
					{tags.map((tag) => (
						<button class="tag-filter" type="button" data-tag-filter={tag} aria-pressed="false">
							{tag}
						</button>
					))}
				</div>
			)}
		</div>

		<div class="collection-body" data-reveal>
			{remainingPosts.length > 0 ? (
				<div class="post-grid">
					{remainingPosts.map((post) => (
						<div data-post-card={post.id} data-reveal>
							<PostCard
								title={post.data.title}
								excerpt={post.data.description}
								href={withBase(`/posts/${post.id}/`)}
								pubDate={post.data.pubDate}
								tags={post.data.tags}
								category={post.data.category}
								readingTime={calculateReadingTime(post.body ?? "")}
							/>
						</div>
					))}
				</div>
			) : posts.length === 0 ? (
				<div class="collection-empty">
					<span class="collection-empty-index">VOL. 00</span>
					<div>
						<h2>The journal is waiting for its first story.</h2>
						<p>
							No stories have been published. Add an owner-approved Markdown
							file in <code>src/content/posts/</code> to begin.
						</p>
					</div>
				</div>
			) : <p class="journal-archive-note">The archive begins with the featured story above.</p>}
			<p class="search-empty" data-search-empty hidden>No stories match this search.</p>
			<p class="visually-hidden" data-search-status role="status" aria-live="polite"></p>
		</div>
	</section>

	<script type="application/json" id="post-search-index" set:html={searchIndexJson}></script>

	<script>
		interface SearchEntry {
			id: string;
			title: string;
			description: string;
			content: string;
			tags: string[];
			category: string;
		}

		const searchInput = document.querySelector<HTMLInputElement>("#post-search-input");
		const indexElement = document.querySelector<HTMLScriptElement>("#post-search-index");

		if (searchInput && indexElement) {
			const index = JSON.parse(indexElement.textContent ?? "[]") as SearchEntry[];
			const normalize = (value: string) =>
				value.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLocaleLowerCase("vi");
			const indexById = new Map(index.map((entry) => [entry.id, entry]));
			const normalizedIndex = new Map(
				index.map((entry) => [
					entry.id,
					normalize([
						entry.title,
						entry.description,
						entry.content,
						entry.category,
						...entry.tags,
					].join(" ")),
				]),
			);
			const cards = [...document.querySelectorAll<HTMLElement>("[data-post-card]")];
			const count = document.querySelector<HTMLElement>("[data-post-count]");
			const emptyMessage = document.querySelector<HTMLElement>("[data-search-empty]");
			const status = document.querySelector<HTMLElement>("[data-search-status]");
			const filterButtons = [
				...document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"),
			];
			const selectedTags = new Set<string>();

			const updateResults = () => {
				const terms = normalize(searchInput.value).trim().split(/\s+/u).filter(Boolean);
				let visibleCount = 0;

				for (const card of cards) {
					const entry = indexById.get(card.dataset.postCard ?? "");
					if (!entry) continue;

					const searchableText = normalizedIndex.get(entry.id) ?? "";
					const matchesText = terms.every((term) => searchableText.includes(term));
					const matchesTag =
						selectedTags.size === 0 ||
						[...selectedTags].some((tag) =>
							entry.tags.some((entryTag) => normalize(entryTag) === normalize(tag)),
						);
					const visible = matchesText && matchesTag;

					card.hidden = !visible;
					if (visible) visibleCount += 1;
				}

				if (count) count.textContent = String(visibleCount);
				if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
				if (status) status.textContent = `${visibleCount} stories`;
			};

			searchInput.addEventListener("input", updateResults);

			for (const button of filterButtons) {
				button.addEventListener("click", () => {
					const tag = button.dataset.tagFilter ?? "all";

					if (tag === "all") {
						selectedTags.clear();
					} else if (selectedTags.has(tag)) {
						selectedTags.delete(tag);
					} else {
						selectedTags.add(tag);
					}

					for (const filterButton of filterButtons) {
						const filterTag = filterButton.dataset.tagFilter ?? "all";
						const active = filterTag === "all"
							? selectedTags.size === 0
							: selectedTags.has(filterTag);
						filterButton.classList.toggle("is-active", active);
						filterButton.setAttribute("aria-pressed", String(active));
					}

					updateResults();
				});
			}

			const initialTag = new URLSearchParams(window.location.search).get("tag");
			if (initialTag) {
				const matchingButton = filterButtons.find(
					(button) => normalize(button.dataset.tagFilter ?? "") === normalize(initialTag),
				);
				matchingButton?.click();
			}
		}
	</script>
</BaseLayout>
