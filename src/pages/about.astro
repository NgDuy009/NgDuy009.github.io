---
import BaseLayout from "../layouts/BaseLayout.astro";
import { editorialImages } from "../lib/editorial";
import { withBase } from "../lib/urls";
---

<BaseLayout
	title="About — DARK TZY"
	description="The point of view and principles behind DARK TZY, a personal fashion and visual culture journal."
>
	<article class="editorial-page">
		<header class="editorial-page-heading" data-reveal>
			<p class="eyebrow">ABOUT / THE POINT OF VIEW</p>
			<h1>A personal<br /><em>way of seeing.</em></h1>
			<p class="editorial-page-deck">
				DARK TZY is a space for fashion, visual culture, and the details that
				make style feel personal.
			</p>
		</header>

		<figure class="about-image editorial-image-frame" data-reveal>
			<img
				src={withBase(editorialImages[2].src)}
				alt={editorialImages[2].alt}
				data-image-mask
				width="960"
				height="1200"
				fetchpriority="high"
				decoding="async"
			/>
			<figcaption>Editorial reference / Unsplash. Not a portrait of the site owner.</figcaption>
		</figure>

		<section class="about-statement" data-reveal aria-labelledby="about-statement-title">
			<p class="eyebrow">A NOTE ON THIS SPACE</p>
			<div>
				<h2 id="about-statement-title">An identity is not a template.</h2>
				<p>
					This maison is personal by intention, but its owner has not yet
					provided a biography, portrait, timeline, or social profiles for
					publication. Those details are left open rather than invented.
				</p>
			</div>
		</section>

		<section class="about-principles" data-reveal aria-labelledby="principles-title">
			<div>
				<p class="eyebrow">THE CREATIVE PHILOSOPHY</p>
				<h2 id="principles-title">Clarity.<br /><em>Character.</em><br />Intention.</h2>
			</div>
			<div class="principle-list">
				<article>
					<span>01</span>
					<div><h3>Choose with feeling</h3><p>Personal style begins with what feels true, not what is prescribed.</p></div>
				</article>
				<article>
					<span>02</span>
					<div><h3>Notice the detail</h3><p>Shape, texture, and gesture can say more than a label ever could.</p></div>
				</article>
				<article>
					<span>03</span>
					<div><h3>Leave room to change</h3><p>Identity is lived, revised, and never finished.</p></div>
				</article>
			</div>
		</section>

		<section class="about-open-note" data-reveal>
			<p class="eyebrow">THE JOURNAL IS OPEN</p>
			<p>Stories, images, and personal notes will be added when they are ready to be shared.</p>
			<a class="text-link" href={withBase("/posts/")}>Visit the journal <span aria-hidden="true">↗</span></a>
		</section>
	</article>
</BaseLayout>
