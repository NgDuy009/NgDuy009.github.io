---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { calculateReadingTime } from "../lib/content";
import { editorialImages } from "../lib/editorial";
import { withBase } from "../lib/urls";

const latestPosts = (await getCollection("posts", ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 2);
const featuredCollections = (await getCollection("collections", ({ data }) => data.featured))
	.slice(0, 2);
---

<BaseLayout
	title="DARK TZY — The Art of Individuality"
	description="Personal Fashion · Visual Culture · Creative Journal."
>
	<section class="maison-hero" aria-labelledby="home-title">
		<img
			class="maison-hero-image"
			src={withBase(editorialImages[0].src)}
			alt={editorialImages[0].alt}
			data-image-mask
			data-story-parallax
			width="1200"
			height="1500"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="maison-hero-shade"></div>
		<figure class="maison-hero-inset" aria-label="Fashion campaign study">
			<img
				src={withBase(editorialImages[1].src)}
				alt={editorialImages[1].alt}
				width="960"
				height="1200"
				fetchpriority="high"
				decoding="async"
			/>
			<figcaption><span>CAMPAIGN STUDY / 02</span><span>UNSPLASH EDITORIAL REFERENCE</span></figcaption>
		</figure>
		<div class="maison-hero-copy">
			<p class="maison-kicker" data-hero-stagger>Maison personnelle · Fashion & visual culture</p>
			<h1 id="home-title" data-hero-title><span class="hero-title-line">DARK</span> <em class="hero-title-line">TZY</em></h1>
			<p class="maison-tagline" data-hero-stagger>The Art of Individuality.</p>
			<a class="text-link maison-hero-link" data-magnetic href={withBase("/gallery/")}>
				Enter the visual archive <span aria-hidden="true">↗</span>
			</a>
		</div>
		<p class="maison-hero-caption">CAMPAIGN 01 &nbsp;·&nbsp; EDITORIAL REFERENCES / UNSPLASH</p>
		<p class="maison-hero-edition">PERSONAL STYLE<br />IN A DIFFERENT LIGHT</p>
		<a class="hero-scroll" href="#editorial-note"><span></span>Scroll to discover</a>
	</section>

	<section class="editorial-note" id="editorial-note" data-reveal aria-labelledby="editorial-note-title">
		<p class="eyebrow">A PERSONAL FASHION MAISON</p>
		<div class="editorial-note-copy">
			<h2 id="editorial-note-title">Style is a way<br />of <em>being seen.</em></h2>
			<p>
				DARK TZY is a personal space for fashion, visual culture, and the ideas
				that shape the way we dress. A quiet archive, still taking form.
			</p>
		</div>
	</section>

	<section class="home-collection" data-reveal aria-labelledby="collection-feature-title">
		<div class="home-section-heading">
			<p class="eyebrow">01 / THE COLLECTIONS</p>
			<a class="text-link" href={withBase("/collections/")}>View the archive <span aria-hidden="true">↗</span></a>
		</div>
		<h2 class="visually-hidden" id="collection-feature-title">The collections</h2>
		{featuredCollections.length > 0 ? (
			<div class="collection-grid">
				{featuredCollections.map((collection, index) => (
					<a class="home-collection-feature" href={withBase(`/collections/${collection.id}/`)}>
						<img
							src={withBase(collection.data.cover)}
							alt={collection.data.coverAlt}
							width="960"
							height="1200"
							loading="lazy"
							decoding="async"
						/>
						<span>{collection.data.category} / {String(index + 1).padStart(2, "0")}</span>
						<strong>{collection.data.title}</strong>
					</a>
				))}
			</div>
		) : (
			<div class="collection-opener">
				<a class="collection-opener-image" href={withBase("/gallery/")} aria-label="Open the visual archive">
					<img src={withBase(editorialImages[2].src)} alt={editorialImages[2].alt} data-image-mask width="960" height="1200" loading="lazy" decoding="async" />
					<span>01 / FORM & LIGHT</span>
				</a>
				<div class="collection-opener-copy">
					<p class="eyebrow">A PERSONAL ARCHIVE, GATHERED OVER TIME</p>
					<h2>Considered.<br /><em>Never prescribed.</em></h2>
					<p>
						An open visual index for fashion, silhouette, and detail. These are
						editorial references—not personal looks or claimed collections.
					</p>
					<a class="text-link" href={withBase("/collections/")}>Discover the collection archive <span aria-hidden="true">↗</span></a>
				</div>
				<a class="collection-opener-image collection-opener-image-offset" href={withBase("/gallery/")} aria-label="View more editorial reference images">
					<img src={withBase(editorialImages[4].src)} alt={editorialImages[4].alt} data-image-mask width="960" height="1200" loading="lazy" decoding="async" />
					<span>02 / THE QUIET EDIT</span>
				</a>
			</div>
		)}
	</section>

	<section class="home-image-essay" data-reveal aria-labelledby="image-essay-title">
		<header class="image-essay-heading">
			<p class="eyebrow">AN OPEN MOODBOARD / UNSPLASH REFERENCES</p>
			<h2 id="image-essay-title">The shape<br />of <em>a feeling.</em></h2>
			<a class="text-link" href={withBase("/gallery/")}>View all images <span aria-hidden="true">↗</span></a>
		</header>
		<div class="image-essay-viewport" data-horizontal-viewport tabindex="0" role="region" aria-label="Horizontal fashion editorial image archive">
			<div class="image-essay-track" data-horizontal-track>
				{editorialImages.map((image, index) => (
					<a class="image-essay-frame" href={withBase("/gallery/")} aria-label={`View visual archive: ${image.caption}`}>
						<img src={withBase(image.src)} alt={image.alt} data-image-mask width="960" height="1200" loading="lazy" decoding="async" />
						<span>{String(index + 1).padStart(2, "0")} &nbsp; / &nbsp; {image.caption}</span>
					</a>
				))}
			</div>
		</div>
		<p class="image-essay-note">Self-hosted editorial references. No image represents the owner or a personal outfit.</p>
	</section>

	<section class="campaign-feature" data-reveal aria-labelledby="campaign-title">
		<img
			src={withBase(editorialImages[1].src)}
			alt={editorialImages[1].alt}
			data-image-mask
			width="960"
			height="1200"
			loading="lazy"
			decoding="async"
		/>
		<div class="campaign-copy">
			<p class="eyebrow">02 / VISUAL CULTURE</p>
			<h2 id="campaign-title">A point of view,<br /><em>in the making.</em></h2>
			<p>Fashion is never only what we wear. It is the image, the instinct, and the detail that stays.</p>
			<a class="text-link" href={withBase("/gallery/")}>Enter the visual journal <span aria-hidden="true">↗</span></a>
			<span class="image-credit">EDITORIAL REFERENCE / UNSPLASH</span>
		</div>
	</section>

	<section class="home-journal" data-reveal aria-labelledby="latest-title">
		<header class="home-section-heading">
			<div>
				<p class="eyebrow">03 / THE JOURNAL</p>
				<h2 id="latest-title">Notes on <em>getting dressed.</em></h2>
			</div>
			<a class="text-link" href={withBase("/posts/")}>Read the journal <span aria-hidden="true">↗</span></a>
		</header>
		{latestPosts.length > 0 ? (
			<div class="journal-grid">
				{latestPosts.map((post) => (
					<PostCard
						title={post.data.title}
						excerpt={post.data.description}
						href={withBase(`/posts/${post.id}/`)}
						pubDate={post.data.pubDate}
						tags={post.data.tags}
						category={post.data.category}
						readingTime={calculateReadingTime(post.body ?? "")}
					/>
				))}
			</div>
		) : (
			<div class="journal-empty">
				<p>Stories will find their place here.</p>
				<a class="text-link" href={withBase("/posts/")}>Discover the journal <span aria-hidden="true">↗</span></a>
			</div>
		)}
	</section>

	<section class="home-gallery" data-reveal aria-labelledby="home-gallery-title">
		<div class="home-gallery-heading">
			<p class="eyebrow">04 / A VISUAL INDEX</p>
			<h2 id="home-gallery-title">Looking, <em>closely.</em></h2>
			<a class="text-link" href={withBase("/gallery/")}>Open the gallery <span aria-hidden="true">↗</span></a>
		</div>
		<div class="home-gallery-images">
			<a href={withBase("/gallery/")} aria-label="Explore the fashion editorial gallery">
				<img src={withBase(editorialImages[2].src)} alt={editorialImages[2].alt} data-image-mask width="960" height="1200" loading="lazy" decoding="async" />
			</a>
			<a href={withBase("/gallery/")} aria-label="Explore the fashion editorial gallery">
				<img src={withBase(editorialImages[4].src)} alt={editorialImages[4].alt} data-image-mask width="960" height="1200" loading="lazy" decoding="async" />
			</a>
		</div>
		<p class="image-credit">EDITORIAL REFERENCES / UNSPLASH · NOT PORTRAITS OF THE SITE OWNER</p>
	</section>
</BaseLayout>
