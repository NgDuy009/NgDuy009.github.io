---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { calculateReadingTime } from "../lib/content";
import { editorialImages } from "../lib/editorial";
import { withBase } from "../lib/urls";

const latestPosts = (await getCollection("posts", ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 2);

const tzyPerfumeVariants = [
	{
		name: "LUMIÈRE",
		description: "Pure, soft and radiant.",
		character: "PURE / SOFT / RADIANT",
		image: "/images/tzy-perfume/01-lumiere.png",
		alt: "LUMIÈRE TZY perfume bottle in a light floral composition",
		width: 385,
		height: 383,
	},
	{
		name: "NOIR",
		description: "Bold, mysterious and timeless.",
		character: "BOLD / MYSTERIOUS / TIMELESS",
		image: "/images/tzy-perfume/02-noir.png",
		alt: "NOIR TZY perfume bottle in a dark botanical composition",
		width: 368,
		height: 383,
	},
	{
		name: "FLEUR",
		description: "Elegant, delicate and modern.",
		character: "ELEGANT / DELICATE / MODERN",
		image: "/images/tzy-perfume/03-fleur.png",
		alt: "FLEUR TZY perfume bottle with pale florals and stone",
		width: 393,
		height: 383,
	},
	{
		name: "BLANC",
		description: "Clean, fresh and sophisticated.",
		character: "CLEAN / FRESH / SOPHISTICATED",
		image: "/images/tzy-perfume/04-blanc.png",
		alt: "BLANC TZY perfume bottle in a clean ivory composition",
		width: 365,
		height: 383,
	},
];
---

<BaseLayout
	title="DARK TZY — The Art of Individuality"
	description="DARK TZY — A digital fashion maison. The Art of Individuality."
	heroImage={withBase("/images/hero-main.png")}
>
	<section class="maison-hero" aria-label="DARK TZY fashion maison">
		<img
			class="maison-hero-image"
			src={withBase("/images/hero-main.png")}
			alt=""
			data-image-mask
			data-story-parallax
			width="1734"
			height="907"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="maison-hero-shade"></div>
		<div class="maison-hero-copy">
			<img
				class="maison-hero-logo"
				src={withBase("/images/tzy-monogram.png")}
				alt="TZY monogram"
				width="1254"
				height="1254"
				data-hero-logo
				decoding="async"
			/>
			<p class="maison-kicker" data-hero-kicker>AN INDEPENDENT FASHION MAISON</p>
			<h1 class="maison-tagline">
				<span data-hero-line>THE ART OF</span>
				<span data-hero-line><em>INDIVIDUALITY.</em></span>
			</h1>
			<p class="maison-hero-description" data-hero-description>
				A personal expression of fashion, visual culture and contemporary elegance.
			</p>
			<a class="text-link maison-hero-link" data-magnetic data-hero-cta href={withBase("/about/")}>
				DISCOVER THE MAISON <span aria-hidden="true">→</span>
			</a>
		</div>
		<div class="maison-hero-meta" data-hero-meta>
			<p>EST. 2026</p>
			<p>FASHION / VISUAL CULTURE / LIFESTYLE</p>
			<a class="hero-scroll" href="#editorial-note"><span></span>SCROLL TO EXPLORE</a>
		</div>
	</section>

	<section class="signature-editorial" aria-labelledby="signature-editorial-title">
		<div class="signature-editorial-copy">
			<p class="signature-editorial-eyebrow" data-signature-kicker>DARK TZY — PRIVATE COLLECTION / 001</p>
			<h2 id="signature-editorial-title" class="signature-editorial-title">
				<span data-signature-line>BEYOND</span>
				<span data-signature-line><em>THE ORDINARY.</em></span>
			</h2>
			<p class="signature-editorial-product" data-signature-product>THE SIGNATURE VARSITY</p>
			<span class="signature-editorial-rule" data-signature-rule aria-hidden="true"></span>
			<p class="signature-editorial-description" data-signature-copy>
				A study in contrast, identity and contemporary expression. Designed around the
				balance of monochrome elegance and distinctive individuality.
			</p>
			<ul class="signature-editorial-details" data-signature-details>
				<li>SIGNATURE DESIGN</li>
				<li>BLACK / IVORY</li>
				<li>TZY MONOGRAM</li>
				<li>FRONT &amp; BACK DETAILS</li>
			</ul>
			<p class="signature-editorial-tagline" data-signature-tagline>STYLE BEYOND THE SEEN.</p>
		</div>
		<figure class="signature-editorial-visual" data-signature-parallax>
			<figcaption class="signature-editorial-visual-label">
				<span>001</span>
				<span>FRONT / BACK DETAILS</span>
			</figcaption>
			<img
				src={withBase("/images/tzy-varsity-editorial.png")}
				alt="TZY black and ivory signature varsity jacket, front and back views"
				width="1536"
				height="1024"
				loading="lazy"
				data-signature-image
				decoding="async"
			/>
		</figure>
		<p class="signature-editorial-caption" data-signature-caption>
			A DISTINCTIVE EXPRESSION OF IDENTITY — TZY.
		</p>
	</section>

	<section class="editorial-note" id="editorial-note" data-reveal aria-labelledby="editorial-note-title">
		<p class="eyebrow">THE PHILOSOPHY</p>
		<div class="editorial-note-copy">
			<h2 id="editorial-note-title">Style is not defined.<br /><em>It is discovered.</em></h2>
			<p>
				DARK TZY is a personal fashion and visual universe exploring individuality,
				contemporary aesthetics and the relationship between style and identity.
			</p>
		</div>
	</section>

	<section class="home-collection home-knitwear-section" data-knitwear-editorial aria-labelledby="home-knitwear-title">
		<div class="home-knitwear-copy">
			<p class="home-knitwear-eyebrow" data-knitwear-kicker>TZY PRIVATE COLLECTION — 001</p>
			<h2 class="home-knitwear-title" id="home-knitwear-title">
				<span data-knitwear-line>THE MONOCHROME</span>
				<span data-knitwear-line><em>BLOOM</em></span>
			</h2>
			<span class="home-knitwear-rule" data-knitwear-rule aria-hidden="true"></span>
			<p class="home-knitwear-description" data-knitwear-description>
				A study in timeless elegance, monochromatic botanical artistry and contemporary knitwear.
			</p>
			<ul class="home-knitwear-details" data-knitwear-details>
				<li>IVORY / MONOCHROME</li>
				<li>HIGH-NECK KNITWEAR</li>
				<li>FRONT &amp; BACK SIGNATURE DETAILS</li>
			</ul>
			<p class="home-knitwear-tagline" data-knitwear-tagline>STYLE BEYOND THE SEEN.</p>
		</div>
		<figure class="home-knitwear-visual" data-knitwear-collection-parallax>
			<figcaption class="home-knitwear-visual-label">
				<span>001</span>
				<span>FRONT / BACK DETAILS</span>
			</figcaption>
			<img
				src={withBase("/images/tzy-knitwear-editorial.png")}
				alt="TZY ivory high-neck knitwear with monochrome botanical artwork, front and back views"
				width="1536"
				height="1024"
				loading="lazy"
				data-knitwear-image
				decoding="async"
			/>
		</figure>
	</section>

	<section class="home-image-essay tshirt-exhibition" data-tshirt-exhibition aria-labelledby="image-essay-title">
		<header class="tshirt-exhibition-intro">
			<p class="tshirt-exhibition-eyebrow" data-tshirt-copy>TZY — THE SIGNATURE T-SHIRT COLLECTION</p>
			<h2 id="image-essay-title" class="tshirt-exhibition-title">
				<span data-tshirt-line>An Icon,</span>
				<span data-tshirt-line><em>Reimagined.</em></span>
			</h2>
			<p class="tshirt-exhibition-intro-copy" data-tshirt-copy>
				Two expressions of contemporary elegance. Botanical artistry, refined silhouettes and a signature identity created to be worn beyond convention.
			</p>
			<span class="tshirt-exhibition-rule" data-tshirt-rule aria-hidden="true"></span>
			<p class="tshirt-exhibition-index" data-tshirt-copy>TZY SIGNATURE SERIES <span>001–002</span></p>
		</header>

		<article class="tshirt-look tshirt-look-noir">
			<header class="tshirt-look-copy">
				<p class="tshirt-exhibition-eyebrow">01 / NOIR BOTANICA</p>
				<h3>NOIR<br /><em>BOTANICA</em></h3>
				<p>A study in contrast. Dark sophistication meets delicate botanical expression.</p>
			</header>
			<div class="tshirt-garment-pair">
				<figure class="tshirt-garment-view tshirt-front" data-tshirt-parallax>
					<div class="tshirt-garment-window">
						<img
							src={withBase("/images/tzy-noir-botanica.png")}
							alt="Front of the black TZY Noir Botanica T-shirt with botanical print and chest monogram"
							width="1536"
							height="1024"
							loading="lazy"
							decoding="async"
							data-tshirt-image
						/>
					</div>
					<figcaption>FRONT</figcaption>
				</figure>
				<figure class="tshirt-garment-view tshirt-back" data-tshirt-parallax>
					<div class="tshirt-garment-window">
						<img
							src={withBase("/images/tzy-noir-botanica.png")}
							alt="Back of the black TZY Noir Botanica T-shirt with botanical print"
							width="1536"
							height="1024"
							loading="lazy"
							decoding="async"
							data-tshirt-image
						/>
					</div>
					<figcaption>BACK</figcaption>
				</figure>
			</div>
		</article>

		<article class="tshirt-look tshirt-look-ivory">
			<header class="tshirt-look-copy">
				<p class="tshirt-exhibition-eyebrow">02 / IVORY BLOOM</p>
				<h3>IVORY<br /><em>BLOOM</em></h3>
				<p>An exploration of light, softness and quiet distinction. A botanical signature expressed through an understated ivory canvas.</p>
			</header>
			<div class="tshirt-ivory-gallery">
				<figure class="tshirt-garment-view tshirt-ivory-front" data-tshirt-parallax>
					<div class="tshirt-garment-window">
						<img
							src={withBase("/images/tzy-ivory-bloom.png")}
							alt="Front of the ivory TZY Bloom T-shirt with botanical print and chest monogram"
							width="1536"
							height="1024"
							loading="lazy"
							decoding="async"
							data-tshirt-image
						/>
					</div>
					<figcaption>IVORY BLOOM / FRONT</figcaption>
				</figure>
				<figure class="tshirt-garment-view tshirt-back tshirt-ivory-back" data-tshirt-parallax>
					<div class="tshirt-garment-window">
						<img
							src={withBase("/images/tzy-ivory-bloom.png")}
							alt="Back of the ivory TZY Bloom T-shirt with botanical print"
							width="1536"
							height="1024"
							loading="lazy"
							decoding="async"
							data-tshirt-image
						/>
					</div>
					<figcaption>BACK / BOTANICAL SILHOUETTE</figcaption>
				</figure>
				<p class="tshirt-vertical-caption">A QUIETER KIND OF STATEMENT — TZY SIGNATURE SERIES</p>
			</div>
		</article>

		<div class="tshirt-detail-study tzy-perfume-exhibition" role="group" aria-labelledby="tshirt-detail-title">
			<header class="tshirt-detail-heading">
				<p class="tshirt-exhibition-eyebrow">TZY — SCENTS BEYOND THE SEEN</p>
				<h3 id="tshirt-detail-title">THE ART OF<br /><em>PERFUME.</em></h3>
				<p class="tshirt-accessory-intro-copy">
					A fragrance for every side of you. Discover four expressions of the DARK TZY olfactory universe, composed in a monochrome language of light, shadow and identity.
				</p>
				<span class="tzy-perfume-index">FOUR FRAGRANCES <span>001 — 004</span></span>
			</header>
			<figure class="tzy-perfume-hero" data-tshirt-parallax>
				<div class="tzy-perfume-hero-image">
					<img
						src={withBase("/images/tzy-perfume/00-main-bottles.png")}
						alt="LUMIÈRE and NOIR TZY perfume bottles presented together in a monochrome floral still life"
						width="870"
						height="428"
						loading="lazy"
						decoding="async"
						data-tshirt-image
					/>
				</div>
				<figcaption><span>THE SIGNATURE PAIR</span><span>LUMIÈRE / NOIR</span></figcaption>
			</figure>

			<div class="tzy-perfume-grid" aria-label="Four TZY fragrances">
				{tzyPerfumeVariants.map((fragrance, index) => (
					<figure class={`tzy-perfume-card tzy-perfume-card-${index + 1}`} data-perfume-card>
						<div class="tzy-perfume-card-image" data-tshirt-parallax>
							<img
								src={withBase(fragrance.image)}
								alt={fragrance.alt}
								width={fragrance.width}
								height={fragrance.height}
								loading="lazy"
								decoding="async"
								data-tshirt-image
							/>
						</div>
						<figcaption>
							<p class="tzy-perfume-meta"><span>0{index + 1}</span> / TZY FRAGRANCE</p>
							<h4>{fragrance.name}</h4>
							<p>{fragrance.description}</p>
							<span class="tzy-perfume-character">{fragrance.character}</span>
						</figcaption>
					</figure>
				))}
			</div>

			<div class="tzy-perfume-details">
				<div class="tzy-perfume-details-heading">
					<p class="tshirt-exhibition-eyebrow">THE OBJECT / THE RITUAL</p>
					<h4>Considered<br /><em>in every detail.</em></h4>
				</div>
				<div class="tzy-perfume-detail-grid">
					<figure class="tzy-perfume-detail" data-perfume-card>
						<div class="tzy-perfume-detail-image">
							<img
								src={withBase("/images/tzy-perfume/05-bottle-detail.png")}
								alt="Close detail of a TZY perfume bottle cap and glass"
								width="290"
								height="197"
								loading="lazy"
								decoding="async"
								data-tshirt-image
							/>
						</div>
						<figcaption>BOTTLE / GLASS DETAIL</figcaption>
					</figure>
					<figure class="tzy-perfume-detail" data-perfume-card>
						<div class="tzy-perfume-detail-image">
							<img
								src={withBase("/images/tzy-perfume/06-fragrance-box.png")}
								alt="Ivory TZY fragrance presentation box"
								width="315"
								height="197"
								loading="lazy"
								decoding="async"
								data-tshirt-image
							/>
						</div>
						<figcaption>THE FRAGRANCE BOX</figcaption>
					</figure>
					<figure class="tzy-perfume-detail" data-perfume-card>
						<div class="tzy-perfume-detail-image">
							<img
								src={withBase("/images/tzy-perfume/07-gift-presentation.png")}
								alt="TZY perfume presented in a signature gift box"
								width="375"
								height="197"
								loading="lazy"
								decoding="async"
								data-tshirt-image
							/>
						</div>
						<figcaption>GIFT PRESENTATION</figcaption>
					</figure>
					<figure class="tzy-perfume-detail" data-perfume-card>
						<div class="tzy-perfume-detail-image">
							<img
								src={withBase("/images/tzy-perfume/09-lumiere-detail.png")}
								alt="Close detail of the TZY LUMIÈRE perfume bottle"
								width="306"
								height="197"
								loading="lazy"
								decoding="async"
								data-tshirt-image
							/>
						</div>
						<figcaption>LUMIÈRE / SIGNATURE</figcaption>
					</figure>
				</div>
			</div>
		</div>

		<footer class="tshirt-exhibition-closing">
			<div class="tshirt-closing-pair">
				<figure class="tshirt-closing-view tshirt-front" data-tshirt-parallax>
					<div class="tshirt-garment-window">
						<img
							src={withBase("/images/tzy-noir-botanica.png")}
							alt="Noir Botanica TZY T-shirt, front view"
							width="1536"
							height="1024"
							loading="lazy"
							decoding="async"
							data-tshirt-image
						/>
					</div>
				</figure>
				<figure class="tshirt-closing-view tshirt-ivory-front" data-tshirt-parallax>
					<div class="tshirt-garment-window">
						<img
							src={withBase("/images/tzy-ivory-bloom.png")}
							alt="Ivory Bloom TZY T-shirt, front view"
							width="1536"
							height="1024"
							loading="lazy"
							decoding="async"
							data-tshirt-image
						/>
					</div>
				</figure>
			</div>
			<div class="tshirt-closing-copy">
				<p class="tshirt-exhibition-eyebrow">TZY SIGNATURE SERIES / 001–002</p>
				<h3>Two Tones.<br /><em>One Signature.</em></h3>
				<p>Different expressions, united by a singular vision of style.</p>
				<span>TZY — STYLE BEYOND THE SEEN.</span>
			</div>
		</footer>
	</section>

	<section class="campaign-feature" data-reveal aria-labelledby="campaign-title">
		<img
			src={withBase(editorialImages[3].src)}
			alt={editorialImages[3].alt}
			data-image-mask
			width="960"
			height="1200"
			loading="lazy"
			decoding="async"
		/>
		<div class="campaign-copy">
			<p class="eyebrow">02 / VISUAL CULTURE</p>
			<h2 id="campaign-title">A point of view,<br /><em>in the making.</em></h2>
			<p>Fashion is never only what we wear. It is the image, the instinct, and the detail that stays.</p>
			<a class="text-link" href={withBase("/gallery/")}>Enter the visual journal <span aria-hidden="true">↗</span></a>
			<span class="image-credit">EDITORIAL REFERENCE / UNSPLASH</span>
		</div>
	</section>

	<section class="home-journal" data-reveal aria-labelledby="latest-title">
		<header class="home-section-heading">
			<div>
				<p class="eyebrow">03 / THE JOURNAL</p>
				<h2 id="latest-title">Notes on <em>getting dressed.</em></h2>
			</div>
			<a class="text-link" href={withBase("/posts/")}>Read the journal <span aria-hidden="true">↗</span></a>
		</header>
		{latestPosts.length > 0 ? (
			<div class="journal-grid">
				{latestPosts.map((post) => (
					<PostCard
						title={post.data.title}
						excerpt={post.data.description}
						href={withBase(`/posts/${post.id}/`)}
						pubDate={post.data.pubDate}
						tags={post.data.tags}
						category={post.data.category}
						readingTime={calculateReadingTime(post.body ?? "")}
					/>
				))}
			</div>
		) : (
			<div class="journal-empty">
				<p>Stories will find their place here.</p>
				<a class="text-link" href={withBase("/posts/")}>Discover the journal <span aria-hidden="true">↗</span></a>
			</div>
		)}
	</section>

	<section class="home-gallery" data-reveal aria-labelledby="home-gallery-title">
		<div class="home-gallery-heading">
			<p class="eyebrow">04 / A VISUAL INDEX</p>
			<h2 id="home-gallery-title">Looking, <em>closely.</em></h2>
			<a class="text-link" href={withBase("/gallery/")}>Open the gallery <span aria-hidden="true">↗</span></a>
		</div>
		<div class="home-gallery-images">
			<a href={withBase("/gallery/")} aria-label="Explore the fashion editorial gallery">
				<img src={withBase(editorialImages[2].src)} alt={editorialImages[2].alt} data-image-mask width="960" height="1200" loading="lazy" decoding="async" />
			</a>
			<a href={withBase("/gallery/")} aria-label="Explore the fashion editorial gallery">
				<img src={withBase(editorialImages[4].src)} alt={editorialImages[4].alt} data-image-mask width="960" height="1200" loading="lazy" decoding="async" />
			</a>
		</div>
		<p class="image-credit">EDITORIAL REFERENCES / UNSPLASH · NOT PORTRAITS OF THE SITE OWNER</p>
	</section>
</BaseLayout>
