---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
---

<BaseLayout
	title="404 — DARK TZY"
	description="This page could not be found. Return to the DARK TZY maison."
	noIndex
>
	<section class="page-shell not-found" aria-labelledby="not-found-title">
		<p class="eyebrow">ERROR / 404</p>
		<h1 id="not-found-title">Signal not found.</h1>
		<p class="page-heading-description">
			The page you are looking for does not exist or has moved.
		</p>
		<a class="button button-primary" href={withBase("/")}>Return home <span aria-hidden="true">↗</span></a>
	</section>
</BaseLayout>
