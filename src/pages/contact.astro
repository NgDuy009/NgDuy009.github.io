---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
---

<BaseLayout
	title="Contact — DARK TZY"
	description="Contact DARK TZY for conversations and creative enquiries."
>
	<section class="contact-page">
		<header class="contact-heading" data-reveal>
			<p class="eyebrow">CONTACT / A NOTE, WHEN IT'S READY</p>
			<h1>Make room<br />for <em>good things.</em></h1>
			<p>
				A genuine connection starts with a real channel. Verified email and
				social links have not been supplied for publication yet.
			</p>
		</header>
		<div class="contact-note" data-reveal>
			<span class="contact-note-mark" aria-hidden="true">✳</span>
			<div>
				<p class="eyebrow">NO PLACEHOLDER FORM</p>
				<h2>When there's a way to reach out, it will be here.</h2>
				<p>
					This page will only list contact details after they are confirmed.
					There is no simulated message form or unmonitored inbox.
				</p>
				<a class="text-link" href={withBase("/about/")}>A little about this space <span aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>
</BaseLayout>
