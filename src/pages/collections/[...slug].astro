---
import { getCollection, render } from "astro:content";
import EditorialImage from "../../components/EditorialImage.astro";
import GalleryLightbox from "../../components/GalleryLightbox.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/content";
import { absoluteSiteUrl, withBase } from "../../lib/urls";

export async function getStaticPaths() {
	const collections = await getCollection("collections");
	return collections.map((collection) => ({
		params: { slug: collection.id },
		props: { collection },
	}));
}

const { collection } = Astro.props;
const { Content } = await render(collection);
const images = collection.data.images.filter((image) => image.src !== collection.data.cover);
const hasStory = Boolean(collection.body?.trim());
const canonicalUrl = Astro.site
	? absoluteSiteUrl(`/collections/${collection.id}/`, Astro.site)
	: undefined;
---

<BaseLayout
	title={`${collection.data.title} — DARK TZY`}
	description={collection.data.description}
	canonicalUrl={canonicalUrl}
	ogType="article"
	ogImage={collection.data.cover}
	ogImageAlt={collection.data.coverAlt}
>
	<article class="collection-detail">
		<header class="collection-detail-heading" data-reveal>
			<figure class="collection-detail-cover">
				<button
					class="editorial-image-trigger"
					type="button"
					data-lightbox-trigger
					data-image-src={withBase(collection.data.cover)}
					data-image-alt={collection.data.coverAlt}
					data-image-caption={collection.data.title}
					aria-label={`Open collection cover: ${collection.data.title}`}
				>
					<img
						src={withBase(collection.data.cover)}
						alt={collection.data.coverAlt}
						data-image-mask
						width="1600"
						height="1100"
						fetchpriority="high"
						decoding="async"
					/>
				</button>
				<figcaption><span>{collection.data.category} / COLLECTION IMAGE</span><span>{collection.data.title}</span></figcaption>
			</figure>
			<div class="collection-detail-copy">
				<a class="text-link" href={withBase("/collections/")}>← All collections</a>
				<p class="eyebrow">{collection.data.category} / COLLECTION NOTE</p>
				<h1>{collection.data.title}</h1>
				<p class="collection-detail-deck">{collection.data.description}</p>
				{collection.data.date && <time datetime={collection.data.date.toISOString()}>{formatDate(collection.data.date)}</time>}
			</div>
		</header>
		{hasStory && (
			<div class="collection-story-grid" data-reveal>
				<p class="collection-story-label">THE STORY<br />/ {collection.data.category.toUpperCase()}</p>
				<div class="collection-story"><Content /></div>
			</div>
		)}
		{images.length > 0 && (
			<div class="collection-detail-gallery" data-layout={collection.data.layout} aria-label="Images in this collection">
				{images.map((image, index) => (
					<EditorialImage
						image={{
							...image,
							caption: image.caption ?? collection.data.title,
							orientation: index % 3 === 1 ? "landscape" : "portrait",
							source: "Collection image",
						}}
						index={index + 1}
					/>
				))}
			</div>
		)}
		<GalleryLightbox />
		{collection.data.tags.length > 0 && (
			<ul class="collection-tags" aria-label="Collection tags">
				{collection.data.tags.map((tag) => <li>{tag}</li>)}
			</ul>
		)}
	</article>
</BaseLayout>
