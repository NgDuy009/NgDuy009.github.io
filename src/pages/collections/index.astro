---
import { getCollection } from "astro:content";
import CollectionCard from "../../components/CollectionCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/urls";

const collections = await getCollection("collections");
const categories = [...new Set(collections.map(({ data }) => data.category))].sort();
---

<BaseLayout
	title="Collections — DARK TZY"
	description="An evolving archive of personal fashion collections, outfit studies, and visual notes."
>
	<section class="archive-page">
		<header class="archive-page-heading" data-reveal>
			<p class="eyebrow">THE ARCHIVE / COLLECTIONS</p>
			<h1>Clothes, considered<br /><em>in context.</em></h1>
			<div class="archive-heading-foot">
				<p>Personal collections and visual studies, gathered over time.</p>
				<span>{String(collections.length).padStart(2, "0")} / ENTRIES</span>
			</div>
		</header>

		{categories.length > 0 && (
			<div class="collection-filter-row" data-collection-filters data-reveal aria-label="Filter collections by category">
				<button type="button" class="collection-filter is-active" data-collection-filter="all" aria-pressed="true">All</button>
				{categories.map((category) => (
					<button type="button" class="collection-filter" data-collection-filter={category} aria-pressed="false">{category}</button>
				))}
				<span class="collection-filter-count">{collections.length} stories</span>
			</div>
		)}

		{collections.length > 0 ? (
			<div class="editorial-collection-grid" data-collection-grid>
				{collections.map((collection, index) => (
					<div data-collection-card data-category={collection.data.category}>
						<CollectionCard
							title={collection.data.title}
							description={collection.data.description}
							category={collection.data.category}
							cover={collection.data.cover}
							coverAlt={collection.data.coverAlt}
							href={`/collections/${collection.id}/`}
							index={index}
						/>
					</div>
				))}
			</div>
		) : (
			<div class="archive-empty" data-reveal>
				<p class="eyebrow">A QUIET BEGINNING</p>
				<h2>No personal looks<br /><em>have been published yet.</em></h2>
				<p>
					This archive is ready for owner-confirmed collections. It will not
					present editorial references as personal outfits.
				</p>
				<a class="text-link" href={withBase("/gallery/")}>Browse the visual journal <span aria-hidden="true">↗</span></a>
			</div>
		)}
	</section>

	<script>
		const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-collection-filter]")];
		const cards = [...document.querySelectorAll<HTMLElement>("[data-collection-card]")];
		for (const filter of filters) {
			filter.addEventListener("click", () => {
				const category = filter.dataset.collectionFilter ?? "all";
				for (const card of cards) card.hidden = category !== "all" && card.dataset.category !== category;
				for (const button of filters) {
					const active = button === filter;
					button.classList.toggle("is-active", active);
					button.setAttribute("aria-pressed", String(active));
				}
			});
		}
	</script>
</BaseLayout>
