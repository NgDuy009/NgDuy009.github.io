---
import { withBase } from "../lib/urls";

const links = [
	{ label: "About", href: withBase("/about/") },
	{ label: "Collections", href: withBase("/collections/") },
	{ label: "Journal", href: withBase("/posts/") },
	{ label: "Gallery", href: withBase("/gallery/") },
	{ label: "Contact", href: withBase("/contact/") },
];

const currentPath = withBase(Astro.url.pathname);
---

<header class="site-header">
	<nav class="container nav-shell" aria-label="Main navigation">
		<a class="wordmark" href={withBase("/")} aria-label="DARK TZY — Home">DARK TZY<span class="wordmark-period">.</span></a>
		<details class="nav-menu">
			<summary class="nav-toggle" aria-label="Toggle navigation">
				<span>MENU</span>
				<span class="menu-icon" aria-hidden="true"></span>
			</summary>
			<div class="nav-links">
				{links.map(({ label, href }) => (
					<a
						class="nav-link"
						href={href}
						aria-current={currentPath === href ? "page" : undefined}
					>
						{label}
					</a>
				))}
				<a class="nav-contact-mark" href={withBase("/contact/")} aria-label="Contact DARK TZY">↗</a>
			</div>
		</details>
	</nav>
</header>

<script>
	const navMenu = document.querySelector(".nav-menu");
	const mobileNavQuery = window.matchMedia("(max-width: 760px)");

	if (navMenu instanceof HTMLDetailsElement) {
		const syncNavToViewport = () => {
			navMenu.open = !mobileNavQuery.matches;
		};
		const closeOnNavigation = () => {
			if (mobileNavQuery.matches) navMenu.open = false;
		};

		syncNavToViewport();
		mobileNavQuery.addEventListener("change", syncNavToViewport);
		navMenu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeOnNavigation));
	}
</script>
