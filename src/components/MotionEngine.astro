<div class="cursor-glow" aria-hidden="true"></div>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const root = document.documentElement;
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	const loader = document.querySelector<HTMLElement>("[data-maison-loader]");

	if (loader) {
		if (reducedMotion.matches) {
			loader.remove();
		} else {
			root.dataset.loaderReady = "true";
			let dismissed = false;
			const dismissLoader = () => {
				if (dismissed) return;
				dismissed = true;
				gsap.to(loader, {
					autoAlpha: 0,
					duration: 0.65,
					delay: 0.15,
					ease: "power2.out",
					onComplete: () => {
						loader.remove();
						root.removeAttribute("data-loader-ready");
					},
				});
			};
			window.addEventListener("load", dismissLoader, { once: true });
			window.setTimeout(dismissLoader, 1500);
		}
	}

	if (!reducedMotion.matches) {
		root.dataset.motionReady = "true";
		const motionQueries = gsap.matchMedia();

		motionQueries.add("(prefers-reduced-motion: no-preference)", () => {
			const heroImage = document.querySelector<HTMLImageElement>(".maison-hero-image");
			const heroCopy = document.querySelector<HTMLElement>(".maison-hero-copy");

			if (heroImage && heroCopy) {
				const intro = gsap.timeline({ defaults: { ease: "power3.out" } });
				intro
					.fromTo(
						heroImage,
						{ scale: 1.06, clipPath: "inset(4% 3% 4% 3%)" },
						{ scale: 1.018, clipPath: "inset(0% 0% 0% 0%)", duration: 1.65 },
						0,
					)
					.to(heroImage, { scale: 1.05, duration: 32, ease: "none", delay: 1.65 }, 0)
					.fromTo(".maison-hero-shade", { autoAlpha: 0.5 }, { autoAlpha: 1, duration: 1.1 }, 0)
					.fromTo(
						"[data-hero-logo]",
						{ autoAlpha: 0, y: 8, filter: "invert(1) blur(9px)" },
						{ autoAlpha: 1, y: 0, filter: "invert(1) blur(0px)", duration: 1.1 },
						0.2,
					)
					.fromTo("[data-hero-kicker]", { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.8 }, 0.38)
					.fromTo(
						"[data-hero-line]",
						{ autoAlpha: 0, y: 20 },
						{ autoAlpha: 1, y: 0, duration: 0.85, stagger: 0.14 },
						0.48,
					)
					.fromTo(
						"[data-hero-description]",
						{ autoAlpha: 0, y: 12 },
						{ autoAlpha: 1, y: 0, duration: 0.8 },
						0.78,
					)
					.fromTo("[data-hero-cta]", { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.8 }, 0.92)
					.fromTo("[data-hero-meta]", { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.9 }, 0.9);
			}

			const signatureSection = document.querySelector<HTMLElement>(".signature-editorial");
			const signatureImage = document.querySelector<HTMLImageElement>("[data-signature-image]");

			if (signatureSection && signatureImage) {
				gsap.timeline({
					defaults: { ease: "power3.out" },
					scrollTrigger: {
						trigger: signatureSection,
						start: "top 74%",
						once: true,
					},
				})
					.fromTo(
						signatureImage,
						{ clipPath: "inset(5% 0% 5% 0%)", scale: 1.035 },
						{ clipPath: "inset(0% 0% 0% 0%)", scale: 1.015, duration: 1.45 },
						0,
					)
					.to(signatureImage, { scale: 1.03, duration: 12, ease: "none" }, 1.45)
					.fromTo("[data-signature-kicker]", { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.8 }, 0.15)
					.fromTo(
						"[data-signature-line]",
						{ autoAlpha: 0, y: 22 },
						{ autoAlpha: 1, y: 0, duration: 0.85, stagger: 0.14 },
						0.26,
					)
					.fromTo(
						"[data-signature-product]",
						{ autoAlpha: 0, y: 12 },
						{ autoAlpha: 1, y: 0, duration: 0.75 },
						0.55,
					)
					.fromTo("[data-signature-rule]", { scaleX: 0 }, { scaleX: 1, duration: 0.8 }, 0.58)
					.fromTo(
						"[data-signature-copy]",
						{ autoAlpha: 0, y: 14 },
						{ autoAlpha: 1, y: 0, duration: 0.8 },
						0.68,
					)
					.fromTo(
						"[data-signature-details] li",
						{ autoAlpha: 0, y: 10 },
						{ autoAlpha: 1, y: 0, duration: 0.65, stagger: 0.08 },
						0.82,
					)
					.fromTo(
						"[data-signature-tagline]",
						{ autoAlpha: 0, y: 10 },
						{ autoAlpha: 1, y: 0, duration: 0.75 },
						1.12,
					)
					.fromTo(
						"[data-signature-caption]",
						{ autoAlpha: 0, y: 8 },
						{ autoAlpha: 1, y: 0, duration: 0.75 },
						0.92,
					);
			}

			const knitwearCollection = document.querySelector<HTMLElement>("[data-knitwear-editorial]");
			const knitwearCollectionImage = document.querySelector<HTMLImageElement>("[data-knitwear-image]");

			if (knitwearCollection && knitwearCollectionImage) {
				const collectionTrigger = {
					trigger: knitwearCollection,
					start: "top 78%",
					once: true,
				};

				gsap.timeline({ scrollTrigger: collectionTrigger })
					.fromTo(
						knitwearCollectionImage,
						{ clipPath: "inset(5% 0% 5% 0%)", scale: 1.035 },
						{ clipPath: "inset(0% 0% 0% 0%)", scale: 1, duration: 1.4, ease: "power3.out" },
					)
					.to(knitwearCollectionImage, { scale: 1.025, duration: 12, ease: "none" });

				gsap.timeline({ scrollTrigger: collectionTrigger })
					.fromTo("[data-knitwear-kicker]", { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.75 })
					.fromTo(
						"[data-knitwear-line]",
						{ autoAlpha: 0, y: 20 },
						{ autoAlpha: 1, y: 0, duration: 0.85, stagger: 0.14 },
						0.12,
					)
					.fromTo("[data-knitwear-rule]", { scaleX: 0 }, { scaleX: 1, duration: 0.8 }, 0.38)
					.fromTo(
						"[data-knitwear-description]",
						{ autoAlpha: 0, y: 12 },
						{ autoAlpha: 1, y: 0, duration: 0.75 },
						0.48,
					)
					.fromTo(
						"[data-knitwear-details] li",
						{ autoAlpha: 0, y: 9 },
						{ autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.08 },
						0.64,
					)
					.fromTo(
						"[data-knitwear-tagline]",
						{ autoAlpha: 0, y: 9 },
						{ autoAlpha: 1, y: 0, duration: 0.7 },
						0.92,
					);
			}

			const tshirtExhibition = document.querySelector<HTMLElement>("[data-tshirt-exhibition]");

			if (tshirtExhibition) {
				const observeTshirtElements = (
					elements: HTMLElement[],
					animate: (element: HTMLElement) => void,
				) => {
					const observer = new IntersectionObserver(
						(entries, currentObserver) => {
							entries.forEach(({ isIntersecting, target }) => {
								if (!isIntersecting) return;
								currentObserver.unobserve(target);
								if (target instanceof HTMLElement) {
									animate(target);
								}
							});
						},
						{ rootMargin: "0px 0px -8% 0px" },
					);
					elements.forEach((element) => observer.observe(element));
				};

				const tshirtIntro = tshirtExhibition.querySelector<HTMLElement>(".tshirt-exhibition-intro");
				if (tshirtIntro) {
					observeTshirtElements([tshirtIntro], (intro) => {
						gsap.timeline({ defaults: { ease: "power3.out" } })
							.fromTo(
								intro.querySelectorAll("[data-tshirt-copy]"),
								{ autoAlpha: 0, y: 14 },
								{ autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.12 },
							)
							.fromTo(
								intro.querySelectorAll("[data-tshirt-line]"),
								{ autoAlpha: 0, y: 24 },
								{ autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.15 },
								0.12,
							)
							.fromTo(
								intro.querySelector("[data-tshirt-rule]"),
								{ scaleX: 0 },
								{ scaleX: 1, duration: 0.85 },
								0.4,
							);
					});
				}

				const tshirtImages = Array.from(tshirtExhibition.querySelectorAll<HTMLElement>("[data-tshirt-image]"));
				observeTshirtElements(tshirtImages, (image) => {
					gsap.fromTo(
						image,
						{ clipPath: "inset(5% 0% 5% 0%)", scale: 1.025 },
						{
							clipPath: "inset(0% 0% 0% 0%)",
							scale: 1,
							duration: 1.2,
							ease: "power3.out",
						},
					);
				});

				const perfumeCards = Array.from(
					tshirtExhibition.querySelectorAll<HTMLElement>(".tzy-perfume-exhibition [data-perfume-card]"),
				);
				observeTshirtElements(perfumeCards, (card) => {
					gsap.fromTo(
						card,
						{ autoAlpha: 0, y: 18 },
						{
							autoAlpha: 1,
							y: 0,
							duration: 0.75,
							delay: (perfumeCards.indexOf(card) % 4) * 0.07,
							ease: "power3.out",
						},
					);
				});

				const tshirtCopyBlocks = Array.from(
					tshirtExhibition.querySelectorAll<HTMLElement>(
						".tshirt-look-copy, .tshirt-detail-heading, .tzy-perfume-details-heading, .tshirt-closing-copy",
					),
				);
				observeTshirtElements(tshirtCopyBlocks, (copy) => {
					gsap.fromTo(
						Array.from(copy.children),
						{ autoAlpha: 0, y: 16 },
						{ autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.1, ease: "power3.out" },
					);
				});
			}

			gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((item) => {
				gsap.fromTo(
					item,
					{ autoAlpha: 0, y: 24 },
					{
						autoAlpha: 1,
						y: 0,
						duration: 0.95,
						ease: "power3.out",
						onComplete: () => item.classList.add("is-visible"),
						scrollTrigger: {
							trigger: item,
							start: "top 88%",
							once: true,
						},
					},
				);
			});

			gsap.utils.toArray<HTMLElement>("[data-image-mask]").forEach((image) => {
				if (image === heroImage) return;
				gsap.fromTo(
					image,
					{ clipPath: "inset(4% 5% 4% 5%)" },
					{
						clipPath: "inset(0% 0% 0% 0%)",
						duration: 1.15,
						ease: "power3.out",
						scrollTrigger: {
							trigger: image,
							start: "top 90%",
							once: true,
						},
					},
				);
			});

			return () => root.removeAttribute("data-motion-ready");
		});

		motionQueries.add("(min-width: 900px)", () => {
			const parallaxTweens = gsap.utils.toArray<HTMLElement>(
				"[data-story-parallax], [data-signature-parallax], [data-knitwear-collection-parallax], [data-tshirt-parallax]",
			).map((image) =>
				gsap.to(image, {
					yPercent: -4,
					ease: "none",
					scrollTrigger: {
						trigger: image,
						start: "top bottom",
						end: "bottom top",
						scrub: 0.6,
					},
				}),
			);
			const horizontalViewport = document.querySelector<HTMLElement>("[data-horizontal-viewport]");
			const horizontalTrack = document.querySelector<HTMLElement>("[data-horizontal-track]");
			const horizontalStory = horizontalViewport?.closest<HTMLElement>(".home-image-essay");

			if (horizontalViewport && horizontalTrack && horizontalStory && horizontalTrack.scrollWidth > horizontalViewport.clientWidth) {
				const getHorizontalDistance = () => {
					const styles = getComputedStyle(horizontalViewport);
					const inlinePadding = Number.parseFloat(styles.paddingLeft) + Number.parseFloat(styles.paddingRight);
					return Math.max(0, horizontalTrack.scrollWidth - (horizontalViewport.clientWidth - inlinePadding));
				};
				horizontalViewport.dataset.scrollStory = "true";
				horizontalStory.dataset.scrollStory = "true";
				gsap.to(horizontalTrack, {
					x: () => -getHorizontalDistance(),
					ease: "none",
					scrollTrigger: {
						trigger: horizontalStory,
						start: () => `top top+=${getComputedStyle(root).getPropertyValue("--nav-height").trim() || "76px"}`,
						end: () => `+=${getHorizontalDistance()}`,
						pin: horizontalStory,
						scrub: 0.8,
						invalidateOnRefresh: true,
						anticipatePin: 1,
					},
				});
			}

			return () => {
				parallaxTweens.forEach((tween) => tween.scrollTrigger?.kill());
				if (horizontalViewport) delete horizontalViewport.dataset.scrollStory;
				if (horizontalStory) delete horizontalStory.dataset.scrollStory;
			};
		});
	}

	const finePointer = window.matchMedia("(pointer: fine)");
	const glow = document.querySelector<HTMLElement>(".cursor-glow");

	if (glow && finePointer.matches && !reducedMotion.matches) {
		root.dataset.cursorGlowReady = "true";

		let pointerX = 0;
		let pointerY = 0;
		let currentX = 0;
		let currentY = 0;
		let frame = 0;
		let hasPointerPosition = false;
		let magneticTarget: HTMLElement | null = null;
		let magneticX = 0;
		let magneticY = 0;
		const parallaxTarget = document.querySelector<HTMLElement>(".maison-hero-image");
		let targetParallaxX = 0;
		let targetParallaxY = 0;
		let parallaxX = 0;
		let parallaxY = 0;

		const resetMagneticTarget = () => {
			if (magneticTarget) {
				magneticTarget.style.setProperty("--magnetic-x", "0px");
				magneticTarget.style.setProperty("--magnetic-y", "0px");
			}

			magneticTarget = null;
			magneticX = 0;
			magneticY = 0;
		};

		const animatePointer = () => {
			const easing = 0.14;
			currentX += (pointerX - currentX) * easing;
			currentY += (pointerY - currentY) * easing;
			glow.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;

			if (magneticTarget) {
				magneticX += (Number(magneticTarget.dataset.targetX ?? 0) - magneticX) * 0.18;
				magneticY += (Number(magneticTarget.dataset.targetY ?? 0) - magneticY) * 0.18;

				magneticTarget.style.setProperty("--magnetic-x", `${magneticX}px`);
				magneticTarget.style.setProperty("--magnetic-y", `${magneticY}px`);
			}

			if (parallaxTarget) {
				parallaxX += (targetParallaxX - parallaxX) * 0.08;
				parallaxY += (targetParallaxY - parallaxY) * 0.08;
				parallaxTarget.style.setProperty("--parallax-x", `${parallaxX}px`);
				parallaxTarget.style.setProperty("--parallax-y", `${parallaxY}px`);
			}

			const pointerSettled =
				Math.abs(pointerX - currentX) < 0.35 &&
				Math.abs(pointerY - currentY) < 0.35;
			const magneticSettled =
				!magneticTarget ||
				(Math.abs(Number(magneticTarget.dataset.targetX ?? 0) - magneticX) < 0.2 &&
					Math.abs(Number(magneticTarget.dataset.targetY ?? 0) - magneticY) < 0.2);
			const parallaxSettled =
				!parallaxTarget ||
				(Math.abs(targetParallaxX - parallaxX) < 0.1 &&
				Math.abs(targetParallaxY - parallaxY) < 0.1);

			if (!pointerSettled || !magneticSettled || !parallaxSettled) {
				frame = requestAnimationFrame(animatePointer);
			} else {
				frame = 0;
			}
		};

		const requestAnimation = () => {
			if (frame === 0) {
				frame = requestAnimationFrame(animatePointer);
			}
		};

		const handlePointerMove = (event: PointerEvent) => {
			if (event.pointerType === "touch" || !finePointer.matches || reducedMotion.matches) {
				glow.classList.remove("is-visible", "is-interactive");
				resetMagneticTarget();
				targetParallaxX = 0;
				targetParallaxY = 0;
				requestAnimation();
				return;
			}

			pointerX = event.clientX;
			pointerY = event.clientY;
			const hero = event.target instanceof Element
				? event.target.closest<HTMLElement>(".maison-hero")
				: null;

			if (hero) {
				const bounds = hero.getBoundingClientRect();
				targetParallaxX = Math.max(-6, Math.min(6, (event.clientX - (bounds.left + bounds.width / 2)) * 0.008));
				targetParallaxY = Math.max(-6, Math.min(6, (event.clientY - (bounds.top + bounds.height / 2)) * 0.008));
			} else {
				targetParallaxX = 0;
				targetParallaxY = 0;
			}

			if (!hasPointerPosition) {
				currentX = pointerX;
				currentY = pointerY;
				glow.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;
				hasPointerPosition = true;
			}

			glow.classList.add("is-visible");

			const target = event.target instanceof Element
				? event.target.closest<HTMLElement>("a, button, summary, [data-magnetic]")
				: null;
			glow.classList.toggle("is-interactive", Boolean(target));

			const nextMagneticTarget = event.target instanceof Element
				? event.target.closest<HTMLElement>("[data-magnetic]")
				: null;

			if (nextMagneticTarget !== magneticTarget) {
				resetMagneticTarget();
				magneticTarget = nextMagneticTarget;
			}

			if (magneticTarget) {
				const bounds = magneticTarget.getBoundingClientRect();
				const strength = Number(magneticTarget.dataset.magneticStrength ?? 0.12);
				const maxOffset = Number(magneticTarget.dataset.magneticLimit ?? 8);
				magneticTarget.dataset.targetX = String(
					Math.max(-maxOffset, Math.min(maxOffset, (event.clientX - (bounds.left + bounds.width / 2)) * strength)),
				);
				magneticTarget.dataset.targetY = String(
					Math.max(-maxOffset, Math.min(maxOffset, (event.clientY - (bounds.top + bounds.height / 2)) * strength)),
				);
			}

			requestAnimation();
		};

		const handlePointerOut = (event: PointerEvent) => {
			if (event.relatedTarget === null) {
				glow.classList.remove("is-visible", "is-interactive");
				resetMagneticTarget();
				targetParallaxX = 0;
				targetParallaxY = 0;
				requestAnimation();
			}
		};

		window.addEventListener("pointermove", handlePointerMove, { passive: true });
		window.addEventListener("pointerout", handlePointerOut, { passive: true });
		window.addEventListener("blur", () => {
			glow.classList.remove("is-visible", "is-interactive");
			resetMagneticTarget();
			targetParallaxX = 0;
			targetParallaxY = 0;
			requestAnimation();
		});
	}
</script>
