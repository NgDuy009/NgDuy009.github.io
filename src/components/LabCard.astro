---
interface Props {
	title: string;
	description: string;
	type: "Experiment" | "Prototype" | "Demo" | "Research";
	tags?: string[];
	date?: Date;
	url?: string;
	github?: string;
}

const { title, description, type, tags = [], date, url, github } = Astro.props;
const formattedDate = date
	? new Intl.DateTimeFormat("vi-VN", {
			day: "numeric",
			month: "short",
			year: "numeric",
		}).format(date)
	: undefined;
---

<article class="lab-card">
	<div class="card-meta">
		<span>{type}</span>
		{formattedDate && <time datetime={date?.toISOString()}>{formattedDate}</time>}
	</div>
	<h2 class="card-title">{title}</h2>
	<p class="card-description">{description}</p>
	<div class="card-footer">
		{tags.length > 0 && (
			<ul class="card-tags" aria-label="Tags">
				{tags.map((tag) => <li>{tag}</li>)}
			</ul>
		)}
		<div class="lab-card-links">
			{github && <a href={github} target="_blank" rel="noreferrer">GitHub ↗</a>}
			{url && <a href={url} target="_blank" rel="noreferrer">Mở demo ↗</a>}
		</div>
	</div>
</article>
