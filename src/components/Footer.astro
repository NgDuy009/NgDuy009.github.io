<footer class="site-footer">
	<div class="footer-main">
		<div>
			<p class="eyebrow">PERSONAL FASHION · VISUAL CULTURE</p>
			<a class="footer-manifesto" href={withBase("/")}>A little more<br /><em>like yourself.</em></a>
		</div>
		<div class="footer-nav">
			<a href={withBase("/about/")}>Maison</a>
			<a href={withBase("/collections/")}>Collections</a>
			<a href={withBase("/posts/")}>Journal</a>
			<a href={withBase("/gallery/")}>Visual Archive</a>
			<a href={withBase("/contact/")}>Contact</a>
		</div>
		<div class="footer-archive">
			<p class="eyebrow">THE HOUSE</p>
			<a href={withBase("/collections/")}>The collections ↗</a>
			<a href={withBase("/gallery/")}>Visual archive ↗</a>
		</div>
	</div>
	<div class="footer-bottom">
		<a class="brand-mark brand-mark-footer" href={withBase("/")} aria-label="DARK TZY — Home">
			<img src={withBase("/images/tzy-monogram.png")} alt="" width="1254" height="1254" loading="lazy" decoding="async" />
